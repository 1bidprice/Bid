{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://investorcontrol.local/schemas/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "sourceType",
    "sourceName",
    "sourceUrl",
    "publishedAt",
    "retrievedAt",
    "eventAt",
    "title",
    "contentHash",
    "companyIds",
    "claimType",
    "reliabilityTier",
    "isPrimarySource"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 8 },
    "sourceType": {
      "type": "string",
      "enum": [
        "REGULATORY_FILING",
        "EXCHANGE_DISCLOSURE",
        "ISSUER_IR",
        "FINANCIAL_NEWS",
        "MARKET_DATA",
        "FUNDAMENTAL_DATA",
        "MACRO_DATA",
        "ALTERNATIVE_DATA",
        "SOCIAL_MEDIA"
      ]
    },
    "sourceName": { "type": "string", "minLength": 1 },
    "sourceUrl": { "type": "string", "format": "uri" },
    "sourceDocumentId": { "type": ["string", "null"] },
    "publishedAt": { "type": "string", "format": "date-time" },
    "retrievedAt": { "type": "string", "format": "date-time" },
    "eventAt": { "type": "string", "format": "date-time" },
    "title": { "type": "string", "minLength": 1 },
    "rawText": { "type": ["string", "null"] },
    "contentHash": { "type": "string", "minLength": 16 },
    "language": { "type": "string", "default": "en" },
    "companyIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "claimType": {
      "type": "string",
      "enum": ["FACT", "CALCULATION_INPUT", "ESTIMATE", "OPINION", "RUMOUR"]
    },
    "reliabilityTier": { "type": "integer", "minimum": 1, "maximum": 5 },
    "isPrimarySource": { "type": "boolean" },
    "independenceGroup": { "type": ["string", "null"] },
    "supportsClaimIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "default": []
    },
    "contradictsClaimIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string" },
      "default": []
    },
    "expiresAt": { "type": ["string", "null"], "format": "date-time" },
    "notes": { "type": ["string", "null"] },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fetchedAt", "contentType", "byteLength", "textLength", "reviewed", "pages"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "REVIEWED_TEXT",
            "REVIEWED_PDF",
            "REVIEWED_NEWS",
            "TEXT_TOO_SHORT",
            "PDF_TEXT_TOO_SHORT",
            "PDF_EXTRACTION_REQUIRED",
            "PDF_EXTRACTION_FAILED",
            "UNSUPPORTED_CONTENT_TYPE",
            "TOO_LARGE",
            "FETCH_FAILED"
          ]
        },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "contentType": { "type": ["string", "null"] },
        "byteLength": { "type": ["integer", "null"], "minimum": 0 },
        "textLength": { "type": "integer", "minimum": 0 },
        "reviewed": { "type": "boolean" },
        "pages": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pageNumber", "textStart", "textEnd", "textLength", "contentHash"],
            "properties": {
              "pageNumber": { "type": "integer", "minimum": 1 },
              "textStart": { "type": "integer", "minimum": 0 },
              "textEnd": { "type": "integer", "minimum": 0 },
              "textLength": { "type": "integer", "minimum": 0 },
              "contentHash": { "type": "string", "minLength": 16 }
            }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractionVersion",
        "documentReviewed",
        "textLength",
        "currencyAmounts",
        "percentages",
        "shareCounts",
        "dates",
        "sections"
      ],
      "properties": {
        "extractionVersion": { "type": "integer", "minimum": 1 },
        "documentReviewed": { "type": "boolean" },
        "textLength": { "type": "integer", "minimum": 0 },
        "currencyAmounts": { "$ref": "#/$defs/numericObservations" },
        "percentages": { "$ref": "#/$defs/numericObservations" },
        "shareCounts": { "$ref": "#/$defs/numericObservations" },
        "dates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["raw", "excerpt", "pageNumber"],
            "properties": {
              "raw": { "type": "string" },
              "excerpt": { "type": "string" },
              "pageNumber": { "type": ["integer", "null"], "minimum": 1 }
            }
          }
        },
        "sections": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "numericObservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["raw", "value", "excerpt", "pageNumber"],
        "properties": {
          "raw": { "type": "string" },
          "value": { "type": ["number", "null"] },
          "excerpt": { "type": "string" },
          "pageNumber": { "type": ["integer", "null"], "minimum": 1 }
        }
      }
    }
  }
}
