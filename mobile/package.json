{
  "name": "investor-control-mobile",
  "version": "1.7.3",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "test:accounting": "node scripts/test-accounting-invariants.cjs",
    "test:lots": "node scripts/test-position-lots.cjs",
    "test:hunter-ui": "node scripts/verify-v170-opportunity-purchase-ui.js",
    "test:release-identity": "node scripts/verify-v171-portfolio-aware-decisions.js",
    "test:quote-transparency": "node scripts/verify-v172-quote-transparency.js",
    "test:instrument-integrity": "node scripts/verify-v173-universal-instrument-integrity.js",
